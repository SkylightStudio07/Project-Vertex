%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c9ae640fc229fb84ebfcf63f4addbb94, type: 3}
  m_Name: Blessing_Machina_Floor0
  m_EditorClassIdentifier: Assembly-CSharp::BlessingData
  entityId: machina
  entityName: "\uB9C8\uD0A4\uB098"
  entityTitle: "\uC7AC\uC0DD\uACFC \uC8FD\uC74C\uC758 \uACBD\uACC4\uC5D0\uC11C"
  speakerIcon: {fileID: 2968897775654309470, guid: 81b0a6741b9c7bf4aa1daec8b48006d6, type: 3}
  background: {fileID: 0}
  chapter: 0
  dialogueText: "\u300C\uC8FD\uC74C, \uADF8\uB9AC\uACE0 \uC7AC\uC0DD.\u300D"
  encounterSequences:
  - sequenceId: enc_sho_reaction
    priority: 100
    minAffinity: 0
    maxAffinity: 999
    requiredCompanionCharId: Cp_01
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uADF8\uB300\uC758 \uACC1\uC5D0 \uC120 \uC790... \uCE7C\uB0A0\uC5D0
        \uB108\uBB34\uB098 \uC9D9\uC740 \uD53C\uC640 \uD6C4\uD68C\uC758 \uB0C4\uC0C8\uAC00
        \uBC30\uC5B4\uC788\uAD6C\uB098.\u300D"
      playerAnswerText: "[\uCE58\uD558\uB77C \uC1FC / \uCE68\uBB35] ...\uB0B4 \uD53C\uB294
        \uB0B4\uAC00 \uC54C\uC544\uC11C \uB2E4\uB8EC\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uD6C4\uD6C4... \uB0A0\uC744 \uB108\uBB34 \uBC14\uC9DD
        \uC138\uC6B0\uC9C0 \uB9C8\uB834, \uC544\uC774\uC57C. \uD53C\uC548\uD654 \uC55E\uC5D0\uC11C\uB294
        \uADF8 \uC5B4\uB5A4 \uC6D0\uB9DD\uB3C4 \uACB0\uAD6D \uACE0\uC694\uD574\uC9C0\uB294
        \uBC95\uC774\uB780\uB2E4.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uC1FC\uB97C \uC9C4\uC815\uC2DC\uD0A4\uBA70
        \uACE0\uAC1C\uB97C \uB044\uB355\uC778\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: enc_tier0
    priority: 10
    minAffinity: 0
    maxAffinity: 1.9
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB54C\uB85C\uB294, \uC774\uC57C\uAE30\uAC00 \uBC1C\uD654\uC790\uB97C
        \uAE30\uBB18\uD55C \uC6B4\uBA85\uC73C\uB85C \uC774\uB04C\uAE30 \uB9C8\uB828\uC774\uC9C0.\u300D"
      playerAnswerText: "\uB2F9\uD669\uD55C \uCC44\uB85C \uB9C8\uD0A4\uB098\uB97C
        \uC751\uC2DC\uD55C\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uC7AC\uD68C\uB97C \uCD95\uBCF5\uD560\uC9C0, \uC544\uB2C8\uBA74
        \uCCAB \uB300\uBA74\uC744 \uD658\uC601\uD574\uC57C \uD560\uC9C0 \uC54C \uC218
        \uC5C6\uB294 \uC77C\uC774\uC57C.\n\uBC84\uD14D\uC2A4\uC5D0 \uC628 \uAC83\uC744
        \uD658\uC601\uD574, \uD0D0\uC0C9\uC790. \uD6C4\uD6C4, \uC5EC\uAE30\uB294
        \uBC84\uD14D\uC2A4\uAC00 \uC544\uB2C8\uC9C0\uB9CC.\u300D"
      playerAnswerText: "\uBB34\uC5B8\uAC00, \uC54C \uC218 \uC5C6\uB294 \uAC10\uC815\uC774
        \uB290\uAEF4\uC9C4\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: enc_tier1
    priority: 10
    minAffinity: 2
    maxAffinity: 3.9
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uC774\uBC88\uC5D0\uB294 \uC7AC\uD68C\uB97C \uD658\uC601\uD574\uC57C
        \uD558\uB824\uB098?\n\uB9C8\uCE58 \uD55C \uBC88 \uC8FD\uC740 \uD45C\uC815\uC774\uB124.
        \uBB50, \uD2C0\uB9B0 \uB9D0\uC740 \uC544\uB2C8\uC9C0..\u300D"
      playerAnswerText: "\uB364\uB364\uD558\uAC8C \uC228\uC744 \uACE0\uB978\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB2F9\uC2E0\uC774 \uBC84\uD14D\uC2A4\uC5D0 \uB300\uD574
        \uD0D0\uAD6C\uD558\uB824 \uD560 \uC218\uB85D, \uBC84\uD14D\uC2A4 \uB610\uD55C
        \uB2F9\uC2E0\uC744 \uD0D0\uAD6C\uD558\uAE30 \uB9C8\uB828.\n\uC7A1\uC544\uBA39\uD788\uC9C0
        \uC54A\uB3C4\uB85D \uC870\uC2EC\uD574.... \uD760, \uB2F9\uC2E0\uC740 \uADF8\uB7F4
        \uAC71\uC815\uC740 \uC5C6\uACA0\uC9C0\uB9CC. .\u300D"
      playerAnswerText: "\uC8FC\uBA39\uC744 \uC954\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: enc_tier2
    priority: 10
    minAffinity: 4
    maxAffinity: 5.9
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uC774\uC81C\uB294 \uB124 \uBC1C\uC18C\uB9AC\uB9CC \uB4E4\uC5B4\uB3C4
        \uC54C\uACA0\uAD6C\uB098. \uCC28\uAC00\uC6B4 \uD53C\uC548\uC758 \uAF43\uBC2D\uC5D0\uB3C4
        \uB108\uC758 \uC628\uAE30\uAC00 \uC870\uAE08\uC740 \uB0A8\uB294 \uBAA8\uC591\uC774\uC57C.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uB9C8\uD0A4\uB098\uC5D0\uAC8C \uC605\uC740
        \uC548\uB3C4\uB97C \uD45C\uD55C\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB108\uC758 \uAC80\uC774 \uBB34\uB38C\uC9C0\uC9C0 \uC54A\uB3C4\uB85D,
        \uC624\uB298\uB3C4 \uB0B4\uAC00 \uACC1\uC5D0\uC11C \uAE38\uC744 \uBE44\uCD94\uC5B4\uC8FC\uB9C8.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uACE0\uAC1C\uB97C \uC219\uC5EC \uAC10\uC0AC\uB97C
        \uC804\uD55C\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: enc_tier3
    priority: 10
    minAffinity: 6
    maxAffinity: 7.9
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB354 \uAE4A\uC740 \uC65C\uACE1\uC758 \uC548\uCABD\uAE4C\uC9C0
        \uB2E4\uB2E4\uB790\uAD70... \uADF8\uACF3\uC758 \uC5B4\uB460\uC774 \uB124
        \uBEA8\uC744 \uC2A4\uCE5C \uD754\uC801\uC774 \uBCF4\uC5EC.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uC2EC\uCE35\uC5D0\uC11C \uB290\uAF08\uB358
        \uD55C\uAE30\uB97C \uB5A0\uC62C\uB9B0\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB450\uB824\uC6CC\uD558\uC9C0 \uB9C8\uB77C. \uAF43\uC78E\uC774
        \uD769\uB0A0\uB9AC\uB294 \uD55C, \uB108\uB294 \uACB0\uCF54 \uC644\uC804\uD788
        \uAE38\uC744 \uC783\uC9C0 \uC54A\uC744 \uD14C\uB2C8.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uACB0\uC758\uC5D0 \uCC2C \uB208\uC73C\uB85C
        \uC55E\uC744 \uBC14\uB77C\uBCF8\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: enc_tier4
    priority: 10
    minAffinity: 8
    maxAffinity: 999
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C...\uB098\uC758 \uBC29\uB791\uC790\uC5EC. \uC774\uC81C
        \uADF8\uB300\uC5D0\uAC8C\uC11C \uB9DD\uC124\uC784\uC758 \uADF8\uB9BC\uC790\uB294
        \uCC3E\uC544\uBCFC \uC218 \uC5C6\uAD6C\uB098.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uB9C8\uD0A4\uB098\uC758 \uB208\uC744
        \uB611\uBC14\uB85C \uB9C8\uC8FC\uD55C\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB05D\uAE4C\uC9C0 \uAC00\uBCF4\uB834. \uAD74\uB808\uB97C
        \uB04A\uC5B4\uB0BC \uB9C8\uC9C0\uB9C9 \uC21C\uAC04\uAE4C\uC9C0, \uB0B4\uAC00
        \uB108\uC758 \uACC1\uC744 \uC9C0\uD0A4\uACA0\uB2E4.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uB9F9\uC138\uB97C \uB2F4\uC544 \uACE0\uAC1C\uB97C
        \uB044\uB355\uC778\uB2E4."
      speakerAvatar: {fileID: 0}
  choices:
  - choiceId: cleanse
    title: "\uC815\uD654"
    description: "\uB371\uC5D0\uC11C \uBD88\uD544\uC694\uD55C \uCE74\uB4DC 1\uC7A5\uC744
      \uC644\uC804\uD788 \uC81C\uAC70\uD569\uB2C8\uB2E4."
    icon: {fileID: 3389322465521877323, guid: 5ec830fdbcd9e0341a9ff1e600e2ee3a, type: 3}
    effectType: 0
    valueCount: 1
    titleColor: {r: 1, g: 0.82, b: 0.4, a: 1}
  - choiceId: refine
    title: "\uC5F0\uB9C8"
    description: "\uAE30\uBCF8 \uCE74\uB4DC 2\uC7A5\uC744 \uC120\uD0DD\uD558\uC5EC
      \uAC15\uD654\uD569\uB2C8\uB2E4."
    icon: {fileID: 694526425948758957, guid: 5ec830fdbcd9e0341a9ff1e600e2ee3a, type: 3}
    effectType: 1
    valueCount: 2
    titleColor: {r: 0.35, g: 0.8, b: 0.95, a: 1}
  - choiceId: supply
    title: "\uBCF4\uAE09"
    description: "\uBAA8\uD5D8\uC5D0 \uB3C4\uC6C0\uC774 \uB418\uB294 \uC18C\uBAA8\uD488
      \uC544\uC774\uD15C 2\uAC1C\uB97C \uAC00\uBC29\uC5D0 \uD68D\uB4DD\uD569\uB2C8\uB2E4."
    icon: {fileID: -1305781175230066861, guid: 5ec830fdbcd9e0341a9ff1e600e2ee3a, type: 3}
    effectType: 2
    valueCount: 2
    titleColor: {r: 0.3, g: 0.88, b: 0.65, a: 1}
  talkChoice:
    choiceId: affinity_talk
    title: "\uAD50\uAC10"
    description: "\uB9C8\uD0A4\uB098\uC640 \uB300\uD654\uB97C \uB098\uB204\uC5B4
      \uCE5C\uBC00\uB3C4\uB97C \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
    icon: {fileID: -7003695537268062503, guid: 074e62b62ff67ea49a618a54404ccbda, type: 3}
    effectType: 6
    valueCount: 1
    titleColor: {r: 0.78, g: 0.58, b: 0.98, a: 1}
  affinityTalkSequences:
  - sequenceId: talk_tier0
    priority: 10
    minAffinity: 0
    maxAffinity: 1.9
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uBB3B\uACE0 \uC2F6\uC740 \uAC8C \uB9CE\uC740 \uB208\uCE58\uB124.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uC870\uC6A9\uD788 \uADC0\uB97C \uAE30\uC6B8\uC778\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uC774\uACF3\uC740 \uBC84\uD14D\uC2A4... \uC218\uB9CE\uC740
        \uC2DC\uAC04\uC758 \uD30C\uD3B8\uACFC \uBA48\uCDB0\uBC84\uB9B0 \uC0DD\uBA85\uC774
        \uB62C\uB9AC\uB97C \uD2BC \uAD00\uBB38.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uC8FC\uBCC0\uC5D0 \uD769\uB0A0\uB9AC\uB294
        \uBC31\uC0C9 \uAF43\uC78E\uC744 \uBC14\uB77C\uBCF8\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB9D0\uD574\uC904 \uC218 \uC788\uB294 \uAC74 \uC774\uAC83
        \uD558\uB098\uC57C. \uC5EC\uAE30 \uC628 \uAC74, \uC628\uC804\uD788 \uB108\uC758
        \uC120\uD0DD..\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uACE0\uAC1C\uB97C \uB044\uB355\uC774\uBA70
        \uB2E4\uC74C \uAE38\uC744 \uC900\uBE44\uD55C\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: talk_tier1
    priority: 10
    minAffinity: 2
    maxAffinity: 3.9
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uAE30\uC5B5?... \uADF8\uB798, \uC2AC\uC2AC \uAD81\uAE08\uD574\uD560
        \uB54C\uAC00 \uB410\uC9C0?.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uC783\uC5B4\uBC84\uB9B0 \uAE30\uC5B5\uC758
        \uB2E8\uD3B8\uC744 \uB354\uB4EC\uB294\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uBA85\uC2EC\uD574 \uC918. \uBC84\uD14D\uC2A4\uB294...
        \uC783\uC5B4\uBC84\uB9B0 \uAC83\uC744 \uCC3E\uC544 \uD5E4\uB9E4\uB294 \uC790\uB97C
        \uAC00\uC7A5 \uC794\uD639\uD558\uAC8C \uAE30\uB9CC\uD558\uB2C8\uAE4C.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uCE68\uBB35 \uC18D\uC5D0\uC11C \uACBD\uAC01\uC2EC\uC744
        \uC0C8\uAE34\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB098\uB77C\uACE0 \uAE30\uC5B5\uC774 \uC628\uC804\uD558\uC9C0
        \uC54A\uC544. \uADF8\uAC74 \uC6B0\uB9AC \uBAA8\uB450\uC758 \uC120\uD0DD\uC774\uC5C8\uC73C\uB2C8\uAE4C.\n\uC5EC\uC815\uC758
        \uB05D\uC5D0\uC11C, \uB2E4\uC2DC \uB9CC\uB0A0 \uC218 \uC788\uAE30\uB97C.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uBB34\uAE30\uC758 \uC190\uC7A1\uC774\uB97C
        \uB2E8\uB2E8\uD788 \uC954\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: talk_tier2
    priority: 10
    minAffinity: 4
    maxAffinity: 5.9
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB098? \uB098 \uB9D0\uC774\uC9C0... \uD6C4\uD6C4, \uAE30\uC5B5\uD574\uC8FC\uC9C0
        \uBABB\uD558\uB2C8 \uC12D\uC12D\uD55C\uAC78.\u300D"
      playerAnswerText: "\uB9C8\uD0A4\uB098\uC758 \uAE30\uBB18\uD55C \uB208\uB3D9\uC790\uB97C
        \uBC14\uB77C\uBCF8\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB098\uB3C4 \uC778\uAC04\uC774\uC57C. '\uCD5C\uCD08\uC758
        \uC138\uB300' \uB300\uC2E0\uC5D0, \uC774 \uBC31\uC0C9\uC758 \uD53C\uC548\uD654\uBC2D\uC744
        \uAD00\uB9AC\uD558\uB294 \uC790... \uB77C\uACE0 \uD558\uB294 \uAC8C \uC801\uB2F9\uD558\uB824\uB098.\u300D"
      playerAnswerText: "\uBC31\uC0C9\uC758 \uD53C\uC548\uD654\uBC2D?"
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uADF8 \uC5EC\uC790\uAC00 \uD55C\uB54C\uB294 \uAD00\uB9AC\uD558\uB358
        \uBC2D. \uC7AC\uC0DD\uACFC \uC8FD\uC74C\uC758 \uACBD\uACC4.\n\uD750\uB4DC\uB7EC\uC9C0\uAC8C
        \uB9CC\uBC1C\uD55C, \uB204\uAD70\uAC00\uC5D0\uAC8C\uB294 \uC5F0\uC625, \uB204\uAD70\uAC00\uC5D0\uAC8C\uB294
        \uB099\uC6D0\uC77C. \u300D"
      playerAnswerText: "\uC870\uC6A9\uD788 \uACE0\uAC1C\uB97C \uB044\uB355\uC778\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: talk_tier3
    priority: 10
    minAffinity: 6
    maxAffinity: 7.9
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uBC84\uD14D\uC2A4\uC758 \uC911\uC2EC\uBD80\uC5D0 \uB300\uD574
        \uB4E3\uACE0 \uC2F6\uB2E4\uACE0? ...\uC88B\uB2E4. \uC774\uC81C\uB294 \uB9D0\uD574\uC904
        \uB54C\uAC00 \uB41C \uAC83 \uAC19\uAD70.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uAE34\uC7A5 \uC18D\uC5D0 \uC9D1\uC911\uD55C\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uADF8\uACF3\uC5D0\uB294 \uAD6C\uC6D0\uC774 \uC874\uC7AC\uD558\uC9C0
        \uC54A\uB294\uB2E4. \uC624\uC9C1 \uB204\uAD70\uAC00\uC758 \uAC00\uC7A5 \uC9C0\uB3C5\uD55C
        \uD6C4\uD68C\uC640, \uBA48\uCDB0\uBC84\uB9B0 \uAC04\uC808\uD55C \uBC14\uB78C\uC774
        \uAD73\uC5B4 \uB9CC\uB4E0 \uAC70\uB300\uD55C \uAC10\uC625\uC77C \uBFD0\uC774\uC9C0.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] '\uADF8\uB807\uB2E4\uBA74 \uC81C\uAC00
        \uAE68\uB728\uB824\uC57C \uD560 \uAC83\uC740...'"
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uADF8\uB798. \uADF8 \uAD73\uC5B4\uBC84\uB9B0 \uC2DC\uACF5\uAC04\uC758
        \uB9E4\uB4ED\uC744 \uB04A\uC5B4\uB0B4\uC57C \uD55C\uB2E4. \uADF8\uB7EC\uC9C0
        \uC54A\uC73C\uBA74 \uC774 \uB054\uCC0D\uD55C \uC724\uD68C\uB294 \uC601\uC6D0\uD788
        \uB05D\uB098\uC9C0 \uC54A\uC544.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uB9F9\uC138\uB97C \uAC00\uC2B4\uC5D0
        \uD488\uB294\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: talk_tier4
    priority: 10
    minAffinity: 8
    maxAffinity: 999
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C...\uC9C4\uC815\uD55C \uB05D\uC744 \uD5A5\uD574 \uAC08
        \uC900\uBE44\uAC00 \uB418\uC5C8\uB290\uB0D0, \uB098\uC758 \uBC29\uB791\uC790\uC5EC.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uB9DD\uC124\uC784 \uC5C6\uC774 \uAC80\uC744
        \uB4E4\uC5B4 \uC62C\uB9B0\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB0B4 \uAC00\uC2B4 \uC18D \uAC00\uC7A5 \uAE4A\uC740 \uACF3\uC5D0
        \uAC04\uC9C1\uD574 \uB450\uC5C8\uB358 \uBC31\uC0C9 \uD53C\uC548\uD654\uC758
        \uC528\uC557\uC744 \uADF8\uB300\uC5D0\uAC8C \uB9E1\uAE30\uB9C8. \uC774\uAC83\uC774
        \uC9C4\uC2E4\uB41C \uAD00\uBB38\uC744 \uC5EC\uB294 \uC5F4\uC1E0\uAC00 \uB420
        \uAC83\uC774\uB2E4.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uD53C\uC548\uD654\uC758 \uC528\uC557\uC744
        \uBC1B\uC544 \uB4E0\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB450\uB824\uC6CC\uD558\uC9C0 \uB9D0\uACE0 \uB098\uC544\uAC00\uB77C.
        \uB124\uAC00 \uC774 \uAD74\uB808\uC758 \uB05D\uC5D0\uC11C \uB2E4\uC2DC \uB208\uB730
        \uB54C\uAE4C\uC9C0, \uB098\uB294 \uD56D\uC0C1 \uC774\uACF3\uC5D0\uC11C \uB108\uB97C
        \uAE30\uB2E4\uB9B4 \uD130\uC774\uB2C8.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uC57D\uC18D\uC744 \uB0A8\uAE30\uACE0
        \uBB38\uC744 \uD5A5\uD574 \uAC78\uC5B4 \uB098\uAC04\uB2E4."
      speakerAvatar: {fileID: 0}
