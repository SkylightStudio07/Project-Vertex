  m_Script: {fileID: 11500000, guid: c9ae640fc229fb84ebfcf63f4addbb94, type: 3}
  m_Name: Blessing_Machina_Floor0
  m_EditorClassIdentifier: Assembly-CSharp::BlessingData
  entityId: machina
  entityName: "\uB9C8\uD0A4\uB098"
  entityTitle: "\uBC31\uC0C9 \uD53C\uC548\uD654\uC758 \uC0AC\uC2E0"
  speakerIcon: {fileID: 2968897775654309470, guid: 81b0a6741b9c7bf4aa1daec8b48006d6, type: 3}
  background: {fileID: 0}
  chapter: 0
  dialogueText: "\u300C\uB208\uC744 \uB5A0\uB77C, \uBD89\uB791\uC790\uC5EC... \uAE38\uC744 \uB5A0\uB098\uAE30 \uC804 \uADF8\uB300\uC5D0\uAC8C \uD55C \uAC00\uC9C0 \uC740\uCD1D\uC744 \uBE00\uD480\uC5B4\uC8FC\uB9C8.\u300D"
  encounterSequences:
  - sequenceId: enc_sho_reaction
    priority: 100
    minAffinity: 0
    maxAffinity: 999
    requiredCompanionCharId: Cp_01
    requiredEventFlag: ''
    forbiddenEventFlag: ''
    setEventFlagOnComplete: ''
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uADF8\uB300\uC758 \uACC1\uC5D0 \uC120 \uC790... \uCE7C\uB0A0\uC5D0 \uB108\uBB34\uB098 \uC9D7\uC740 \uD53C\uC640 \uD6C4\uD68C\uC758 \u smell\uC774 \uBC30\uC5B4\uC788\uAD6C\uB098.\u300D"
      playerAnswerText: "[\uCE58\uD558\uB77C \uC1FC / \uCE68\uBB35] ...\uB0B4 \uD53C\uB294 \uB0B4\uAC00 \uC54C\uC544\uC11C \uB2E4\uB8EC\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uD6C4\uD6C4... \uB0A0\uC744 \uB108\uBB34 \uBC14\uC9DD \uC138\uC6B0\uC9C0 \uB9C8\uB834, \uC544\uC774\uC57C. \uD53C\uC548\uD654 \uC55E\uC5D0\uC11C\uB294 \uADF8 \uC5B4\uB5A4 \uC6D0\uB9DD\uB3C4 \uACB0\uAD6D \uACE0\uC694\uD574\uC9C0\uB294 \uBC95\uC774\uB780\uB2E4.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uC1FC\uB97C \uC9C4\uC815\uC2DC\uD0A4\uBA70 \uACE0\uAC1C\uB97C \uB044\uB355\uC778\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: enc_tier0
    priority: 10
    minAffinity: 0
    maxAffinity: 1.9
    requiredCompanionCharId: ''
    requiredEventFlag: ''
    forbiddenEventFlag: ''
    setEventFlagOnComplete: ''
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB208\uC744 \uB5A0\uB77C, \uBD89\uB791\uC790\uC5EC... \uC774 \uAF43\uBC2D\uC740 \uC0DD\uACFC \uC0AC\uC758 \uACBD\uACC4. \uC544\uC9C1 \uADF8\uB300\uC758 \uBC1C\uAC78\uC74C\uC774 \uC644\uC804\uD788 \uBA4B\uC9C0\uB294 \uC54A\uC558\uAD6C\uB098.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uB9C8\uD0A4\uB098\uC758 \uBC31\uC0C9 \uC637\uC790\uB77D\uC744 \uAC00\uB9CC\uD788 \uC751\uC2DC\uD55C\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uBC84\uD14D\uC2A4\uC758 \uC2EC\uCE35\uC73C\uB85C \uD5A5\uD558\uACE0\uC790 \uD55C\uB2E4\uBA74, \uB0B4 \uC791\uC740 \uAC00\uD638\uB97C \uADF8\uB300\uC758 \uC601\uD63C\uC5D0 \uC0C8\uACA8\uB450\uC5B4\uB77C.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uACE0\uAC1C\uB97C \uB044\uB355\uC774\uBA70 \uC190\uC744 \uBF67\uB294\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: enc_tier1
    priority: 10
    minAffinity: 2
    maxAffinity: 3.9
    requiredCompanionCharId: ''
    requiredEventFlag: ''
    forbiddenEventFlag: ''
    setEventFlagOnComplete: ''
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB610\uB2E4\uC2DC \uD769\uC5B4\uC84C\uB2E4 \uBAA8\uC600\uAD6C\uB098. \uBD89\uAC8C \uBB3C\uB4E0 \uBC1C\uC790\uAD6D\uC774 \uC9C0\uCCD0 \uBCF4\uC774\uC9C0\uB9CC... \uB208\uBE5B\uB9CC\uC740 \uB610\uB837\uD558\uAD70.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uB364\uB364\uD558\uAC8C \uC228\uC744 \uACE0\uB978\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uD558\uC9C0\uB9CC \uC870\uC2EC\uD558\uB834. \uBC84\uD14D\uC2A4\uB294 \uC787\uC73C\uB824 \uD558\uB294 \uC790\uC758 \uAE30\uC5B5\uBD80\uD130 \uCC28\uB840\uB85C \uC0BC\uCF1C\uBC84\uB9B0\uB2E8\uB2E4.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uAE30\uC5B5\uC744 \uBD98\uC7A1\uACA0\uB2E4\uB294 \uB4EF \uC8FC\uBA39\uC744 \uC954\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: enc_tier2
    priority: 10
    minAffinity: 4
    maxAffinity: 5.9
    requiredCompanionCharId: ''
    requiredEventFlag: ''
    forbiddenEventFlag: ''
    setEventFlagOnComplete: ''
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uC774\uC81C\uB294 \uB024 \uBC1C\uC18C\uB9AC\uB9CC \uB4E4\uC5B4\uB3C4 \uC54C\uACA0\uAD6C\uB098. \uCC28\uAC00\uC6B4 \uD53C\uC548\uC758 \uAF43\uBC2D\uC5D0\uB3C4 \uB108\uC758 \uC628\uAE30\uAC00 \uC870\uAE08\uC740 \uB0A8\uB294 \uBAA8\uC591\uC774\uC57C.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uB9C8\uD0A4\uB098\uC5D0\uAC8C \uC5EC\uD2BC \uC548\uB3C4\uB97C \uD45C\uD55C\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB108\uC758 \uAC80\uC774 \uBB34\uB38C\uC9C0\uC9C0 \uC54A\uB3C4\uB85D, \uC624\uB298\uB3C4 \uB0B4\uAC00 \uACC1\uC5D0\uC11C \uAE38\uC744 \uBE44\uCD94\uC5B4\uC8FC\uB9C8.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uACE0\uAC1C\uB97C \uC219\uC5EC \uAC10\uC0AC\uB97C \uC804\uD55C\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: enc_tier3
    priority: 10
    minAffinity: 6
    maxAffinity: 7.9
    requiredCompanionCharId: ''
    requiredEventFlag: ''
    forbiddenEventFlag: ''
    setEventFlagOnComplete: ''
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB354 \uAE4A\uC740 \uC65C\uACE1\uC758 \uC548\uCabd\uAE4C\uC9C0 \uB2E4\uB2E4\uB790\uAD70... \uADF8\uACF3\uC758 \uC5B4\uB460\uC774 \uB124 \uBF18\uC744 \uC2A4\uCE5C \uD757\uC801\uC774 \uBCF4\uC5EC.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uC2EC\uCE35\uC5D0\uC11C \uB290\uAF08\uB358 \uD55C\uAE30\uB97C \uB5A0\uC62C\uB9AC\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB450\uB824\uC6CC\uD558\uC9C0 \uB9C8\uB77C. \uAF43\uC78E\uC774 \uD769\uB0A0\uB9AC\uB294 \uD55C, \uB108\uB294 \uACB0\uCF54 \uC644\uC804\uD788 \uAE38\uC744 \uC783\uC9C0 \uC54A\uC744 \uD14C\uB2C8.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uACB0\uC758\uC5D0 \uCC2C \uB208\uC73C\uB85C \uC55E\uC744 \uBC14\uB77C\uBCF8\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: enc_tier4
    priority: 10
    minAffinity: 8
    maxAffinity: 999
    requiredCompanionCharId: ''
    requiredEventFlag: ''
    forbiddenEventFlag: ''
    setEventFlagOnComplete: ''
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C...\uB098\uC758 \uBC29\uB791\uC790\uC5EC. \uC774\uC81C \uADF8\uB300\uC5D0\uAC8C\uC11C \uB9DD\uC124\uC784\uC758 \uADF8\uB9BC\uC790\uB294 \uCC3E\uC544\uBCFC \uC218 \uC5C6\uAD6C\uB098.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uB9C8\uD0A4\uB098\uC758 \uB208\uC744 \uB611\uBC14\uB85C \uB9C8\uC8FC\uD55C\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\u705D\uAE4C\uC9C0 \uAC00\uBCF4\uB834. \uAD74\uB808\uB97C \uB04A\uC5B4\uB0BC \uB9C8\uC9C0\uB9C9 \uC21C\uAC04\uAE4C\uC9C0, \uB0B4\uAC00 \uB108\uC758 \uACC1\uC744 \uC9C0\uD0A4\uACA0\uB2E4.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uB9F9\uC138\uB97C \uB2F4\uC544 \uACE0\uAC1C\uB97C \uB044\uB355\uC778\uB2E4."
      speakerAvatar: {fileID: 0}
  choices:
  - choiceId: cleanse
    title: "\uC815\uD654"
    description: "\uB371\uC5D0\uC11C \uBD88\uD544\uC694\uD55C \uCE74\uB4DC 1\uC7A5\uC744 \uC644\uC804\uD788 \uC81C\uAC70\uD569\uB2C8\uB2E4."
    icon: {fileID: 3389322465521877323, guid: 5ec830fdbcd9e0341a9ff1e600e2ee3a, type: 3}
    effectType: 0
    valueCount: 1
    titleColor: {r: 1, g: 0.82, b: 0.4, a: 1}
  - choiceId: refine
    title: "\uC5F0\uB9C8"
    description: "\uAE30\uBCF8 \uCE74\uB4DC 2\uC7A5\uC744 \uC120\uD0DD\uD558\uC5EC \uAC15\uD654\uD569\uB2C8\uB2E4."
    icon: {fileID: 694526425948758957, guid: 5ec830fdbcd9e0341a9ff1e600e2ee3a, type: 3}
    effectType: 1
    valueCount: 2
    titleColor: {r: 0.35, g: 0.8, b: 0.95, a: 1}
  - choiceId: supply
    title: "\uBCF4\uAE09"
    description: "\uBAA8\uD5D8\uC5D0 \uB3C4\uC6C0\uC774 \uB418\uB294 \uC18C\uBAA8\uD488 \uC544\uC774\uD15C 2\uAC1C\uB97C \uAC00\uBC29\uC5D0 \uD68D\uB4DD\uD569\uB2C8\uB2E4."
    icon: {fileID: -1305781175230066861, guid: 5ec830fdbcd9e0341a9ff1e600e2ee3a, type: 3}
    effectType: 2
    valueCount: 2
    titleColor: {r: 0.3, g: 0.88, b: 0.65, a: 1}
  talkChoice:
    choiceId: affinity_talk
    title: "\uAD50\uAC10"
    description: "\uB9C8\uD0A4\uB098\uC640 \uB300\uD654\uB97C \uB098\uB220 \uCE5C\uBC00\uB3C4\uB97C 1 \uC0C1\uC2B9\uC2DC\uD0A4\uACE0, \uBC84\uD14D\uC2A4\uC758 \uC228\uACA8\uC9C4 \uAE30\uC5B5\uC744 \uB4E3\uC2B5\uB2C8\uB2E4."
    icon: {fileID: -7003695537268062503, guid: 074e62b62ff67ea49a618a54404ccbda, type: 3}
    effectType: 6
    valueCount: 1
    titleColor: {r: 0.78, g: 0.58, b: 0.98, a: 1}
  affinityTalkSequences:
  - sequenceId: talk_tier0
    priority: 10
    minAffinity: 0
    maxAffinity: 1.9
    requiredCompanionCharId: ''
    requiredEventFlag: ''
    forbiddenEventFlag: ''
    setEventFlagOnComplete: ''
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB098\uC5D0 \uB300\uD574 \uBB3B\uACE0 \uC2F6\uC740 \uAC8C \uB9CE\uC740 \uB208\uCE58\uAD6C\uB098. \uD558\uC9C0\uB9CC \uC11C\uB450\uB97C \uAC83 \uC5C6\uB2E4.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uC870\uC6A9\uD788 \uADC0\uB97C \uAE30\uC6B8\uC778\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uC774\uACF3\uC740 \uBC84\uD14D\uC2A4... \uC218\uB9CE\uC740 \uC2DC\uAC04\uC758 \uD30C\uD3B8\uACFC \uBA48\uCCD8\uBC84\uB9B0 \uC0DD\uBA85\uC774 \uB614\uB9AC\uB97C \uD2BC \uAD00\uBB38\uC774\uB780\uB2E4.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uC8FC\uBCC0\uC5D0 \uD769\uB0A0\uB9AC\uB294 \uBC31\uC0C9 \uAF43\uC78E\uC744 \uBC14\uB77C\uBCF8\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uC5B8\uC popular\uAC00 \uB124\uAC00 \uB354 \uAE4A\uC740 \uACF3\uC5D0 \uB3C4\uB2EC\uD588\uC744 \uB54C, \uADF8\uB54C \uB354 \uB9CE\uC740 \uC774\uC57C\uAE30\uB97C \uB4E4\uB824\uC8FC\uB9C8. \uC9C0\uAE08\uC740 \uBB34\uAE30\uB97C \uB2E4\uB4EC\uC73C\uB834.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uACE0\uAC1C\uB97C \uB044\uB355\uC774\uBA70 \uB2E4\uC74C \uAE38\uC744 \uC900\uBE44\uD55C\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: talk_tier1
    priority: 10
    minAffinity: 2
    maxAffinity: 3.9
    requiredCompanionCharId: ''
    requiredEventFlag: ''
    forbiddenEventFlag: ''
    setEventFlagOnComplete: ''
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uAE30\uC5B5\uC5D0 \uB300\uD574 \uBB3B\uB294 \uAC83\uC778\uAC00... \uB124\uAC00 \uC787\uC740 \uACFC\uAC70\uAC00 \uBB34\uC5C7\uC778\uC9C0 \uB098 \uC5ED\uC2DC \uC804\uBD80 \uC54C\uC9C0\uB294 \uBABB\uD55C\uB2E8\uB2E4.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uC783\uC5B4\uBC84\uB9B0 \uAE30\uC5B5\uC758 \uB2E8\uD3B8\uC744 \uB354\uB4EC\uB294\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uD558\uC9C0\uB9CC \uC774\uAC83\uB9CC\uC740 \uBA85\uC2EC\uD558\uB834. \uBC84\uD14D\uC2A4\uB294 \uC783\uC5B4\uBC84\uB9B0 \uAC83\uC744 \uCC3E\uC544 \uD5E4\uB9E4\uB294 \uC790\uB97C \uAC00\uC7A5 \uC794\uD639\uD558\uAC8C \uAE30\uB9CC\uD558\uC9C0.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uCE68\uBB35 \uC18D\uC5D0\uC11C \uACBD\uAC01\uC2EC\uC744 \uC0C8\uAE34\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB124\uAC00 \uBD99\uC7A1\uC544\uC57C \uD560 \uAC83\uC740 \uC9C0\uB098\uAC04 \uC5B4\uC81C\uAC00 \uC544\uB2C8\uB77C, \uC9C0\uAE08 \uB124 \uC190\uC5D0 \uC950\uC5B4\uC9C4 \uBB34\uAE30\uB780\uB2E4.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uBB34\uAE30\uC758 \uC190\uC7A1\uC774\uB97C \uB2E8\uB2E8\uD788 \uC954\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: talk_tier2
    priority: 10
    minAffinity: 4
    maxAffinity: 5.9
    requiredCompanionCharId: ''
    requiredEventFlag: ''
    forbiddenEventFlag: ''
    setEventFlagOnComplete: ''
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C...\uB0B4\uAC00 \uC65C \uC0AC\uC2E0\uC774\uB77C \uBD88\uB9AC\uBA70 \uC774\uACF3\uC5D0 \uB0A8\uC558\uB294\uC9C0 \uAD81\uAE08\uD55C \uBAA8\uC591\uC774\uAD70.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uB9C8\uD0A4\uB098\uC758 \uC2AC\uD508 \uB208\uB3D9\uC790\uB97C \uBC14\uB77C\uBCF8\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB098 \uC5ED\uC2DC \uD55C\uB54C\uB294 \uBB34\uC5B8\uAC00\uB97C \uB418\uB3CC\uB9AC\uB824 \uC800 \uC548\uCabd\uC73C\uB85C \uD5A5\uD588\uC5C8\uB2E8\uB2E4. \uC18C\uC911\uD55C \uAC83\uC744 \uAD6C\uC6D0\uD560 \uC218 \uC788\uC73C\uB9AC\uB77C \uBBFF\uC5C8\uC9C0.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] '\uADF8 \uACB0\uACFC\uAC00... \uC774 \uAF43\uBC2D\uC785\uB2C8\uAE4C?'"
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C...\uACB0\uAD6D \uB0A8\uC740 \uAC83\uC740 \uC774 \uBC31\uC0C9 \uD53C\uC548\uD654\uB4E4\uBFD0\uC774\uC5C8\uC5B4. \uD558\uC9C0\uB9CC \uB108\uB77C\uBA74... \uB098\uC640\uB294 \uB2E4\uB978 \uACB0\uB9D0\uC744 \uB9FA\uC744\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uAD6C\uB098.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uADF8\uB140\uC758 \uC9D0\uAE4C\uC9C0 \uC9CA\uC5B4\uC9C0\uB4EF \uACB0\uC5F0\uD788 \uB044\uB355\uC778\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: talk_tier3
    priority: 10
    minAffinity: 6
    maxAffinity: 7.9
    requiredCompanionCharId: ''
    requiredEventFlag: ''
    forbiddenEventFlag: ''
    setEventFlagOnComplete: ''
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uBC84\uD14D\uC2A4\uC758 \uC2EC\uCE35\uBD80\uC5D0 \uB300\uD574 \uB4E3\uACE0 \uC2F6\uB2E4\uACE0? ...\uC88B\uB2E4. \uC774\uC81C\uB294 \uB9D0\uD574\uC904 \uB54C\uAC00 \uB41C \uAC83 \uAC19\uAD70.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uAE34\uC7A5 \uC18D\uC5D0 \uC9D1\uC911\uD55C\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uADF8\uACF3\uC5D0\uB294 \uAD6C\uC6D0\uC774 \uC874\uC7AC\uD558\uC9C0 \uC54A\uB294\uB2E4. \uC624\uC9C1 \uB204\uAD70\uAC00\uC758 \uAC00\uC7A5 \uC9C0\uB3C5\uD55C \uD6C4\uD68C\uC640, \uBA48\uCCD8\uBC84\uB9B0 \uAC04\uC808\uD55C \uBC14\uB78C\uC774 \uAD73\uC5B4 \uB9CC\uB4E0 \uAC70\uB300\uD55C \uAC10\uC625\uC77C \uBFD0\uC774\uC9C0.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] '\uADF8\uB807\uB2E4\uBA74 \uC81C\uAC00 \uAE68\uB728\uB824\uC57C \uD560 \uAC83\uC740...'"
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uADF8\uB798. \uADF8 \uAD73\uC5B4\uBC84\uB9B0 \uC2DC\uACF5\uAC04\uC758 \uB9E4\uB4ED\uC744 \uB04A\uC5B4\uB0B4\uC57C \uD55C\uB2E4. \uADF8\uB7EC\uC9C0 \uC54A\uC73C\uBA74 \uC774 \uB054\uCC0D\uD55C \uC724\uD68C\uB294 \uC601\uC6D0\uD788 \u705D\uB098\uC9C0 \uC54A\uC544.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uB9F9\uC138\uB97C \uAC00\uC2B4\uC5D0 \uD488\uB294\uB2E4."
      speakerAvatar: {fileID: 0}
  - sequenceId: talk_tier4
    priority: 10
    minAffinity: 8
    maxAffinity: 999
    requiredCompanionCharId: ''
    requiredEventFlag: ''
    forbiddenEventFlag: ''
    setEventFlagOnComplete: ''
    steps:
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C...\uC9C4\uC815\uD55C \u705D\uC744 \uD5A5\uD574 \uAC08 \uC900\uBE44\uAC00 \uB418\uC5C8\uB290\uB0D0, \uB098\uC758 \uBC29\uB791\uC790\uC5EC.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uB9DD\uC124\uC784 \uC5C6\uC774 \uAC80\uC744 \uB4E4\uC5B4 \uC62C\uB9B0\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB0B4 \uAC00\uC2B4 \uC18D \uAC00\uC7A5 \uAE4A\uC740 \uACF3\uC5D0 \uAC04\uC9C1\uD574 \uB450\uC5C8\uB358 \uBC31\uC0C9 \uD53C\uC548\uD654\uC758 \uC528\uC557\uC744 \uADF8\uB300\uC5D0\uAC8C \uB9E1\uAE30\uB9C8. \uC774\uAC83\uC774 \uC9C4\uC2E4\uB41C \uAD00\uBB38\uC744 \uC5EC\uB294 \uC5F4\uC1E0\uAC00 \uB420 \uAC83\uC774\uB2E4.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uD53C\uC548\uD654\uC758 \uC528\uC557\uC744 \uBC1B\uC544 \uB4E0\uB2E4."
      speakerAvatar: {fileID: 0}
    - speakerName: "\uB9C8\uD0A4\uB098"
      npcDialogue: "\u300C\uB450\uB824\uC6CC\uD558\uC9C0 \uB9D0\uACE0 \uB098\uC544\uAC00\uB77C. \uB124\uAC00 \uC774 \uAD74\uB808\uC758 \u705D\uC5D0\uC11C \uB2E4\uC2DC \uB208\uB530 \uB54C\uAE4C\uC9C0, \uB098\uB294 \uD56D\uC1 Sang \uC774\uACF3\uC5D0\uC11C \uB108\uB97C \uAE30\uB2E4\uB9B4 \uD130\uC774\uB2C8.\u300D"
      playerAnswerText: "[\uBC29\uB791\uC790] \uC57D\uC18D\uC744 \uB0A8\uAE30\uACE0 \uBB38\uC744 \uD5A5\uD574 \uAC78\uC544 \uB098\uAC04\uB2E4."
      speakerAvatar: {fileID: 0}
