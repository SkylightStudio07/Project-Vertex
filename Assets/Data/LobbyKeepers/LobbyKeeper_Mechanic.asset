--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f70cd7b2f3a5e61468d00394a718233a, type: 3}
  m_Name: LobbyKeeper_Mechanic
  m_EditorClassIdentifier: Assembly-CSharp::LobbyKeeperData
  entityId: lobby_mechanic
  displayName: "\uC815\uBE44 \uB2F4\uB2F9"
  visitAffinityGain: 0.5
  greetingLines:
  - minTier: 0
    lines:
    - "\uC5B4\uB5A4 \uC7A5\uBE44\uB97C \uC190\uBD10 \uC904\uAE4C?"
    - "\uC654\uC5B4? \uC190 \uB354\uB7EC\uC6B0\uB2C8\uAE4C \uC545\uC218\uB294 \uD328\uC2A4."
    - "\uCD1D \uAC00\uC838\uC654\uC73C\uBA74 \uC62C\uB824\uB194."
  - minTier: 2
    lines:
    - "\uC654\uB124. \uC9C0\uB09C\uBC88\uC5D0 \uB9E1\uAE34 \uAC70, \uC18C\uB9AC \uC88B\uC544\uC84C\uC9C0?"
    - "\uAE30\uB2E4\uB9AC\uC9C4 \uC54A\uC558\uC5B4. \uB9C8\uCE68 \uD55C\uAC00\uD588\uC744
      \uBFD0\uC774\uC57C."
  - minTier: 4
    lines:
    - "\uC654\uC5B4. \u2026\uC624\uB298\uC740 \uACF5\uAD6C \uB0B4\uB824\uB193\uACE0
      \uAE30\uB2E4\uB838\uC5B4."
    - "\uB124 \uCD1D \uC18C\uB9AC\uB9CC \uB4E4\uC5B4\uB3C4 \uCEE8\uB514\uC158 \uC54C\uACA0\uB354\uB77C.
      \uC549\uC544."
  clickLines:
  - minTier: 0
    lines:
    - "\uAC74\uB4DC\uB9AC\uC9C0 \uB9C8. \uADF8 \uB80C\uCE58 \uB0B4 \uAC70\uC57C."
    - "\uD30C\uCE20 \uAC00\uC838\uC640. \uC5C6\uC73C\uBA74 \uAE30\uB3C4\uB77C\uB3C4
      \uD558\uB4E0\uAC00."
    - "\uCD1D\uC740 \uB2E6\uC740 \uB9CC\uD07C \uC3F4 \uC918. \uC0AC\uB78C\uC774\uB791
      \uB611\uAC19\uC544."
    - "\uAF2C\uB9AC \uBCF4\uC9C0 \uB9C8. \uC77C \uC548 \uD558\uB0D0."
  - minTier: 2
    lines:
    - "\uB808\uC77C\uAC74? \uADF8\uAC74 \uB098\uB3C4 \uC544\uC9C1 \uB2E4 \uC774\uD574
      \uBABB \uD588\uC5B4. \uADF8\uB798\uC11C \uC7AC\uBC0C\uC5B4."
    - "\uD0C4\uCC3D \uC2A4\uD504\uB9C1 \uAC08 \uB54C \uB410\uC5B4. \uACF5\uC9DC\uB85C
      \uD574 \uC904\uAC8C. \uC774\uBC88\uB9CC."
    - "\uB108, \uBC18\uB3D9 \uC7A1\uB294 \uC190\uBAA9 \uC88B\uC544\uC84C\uB2E4. \uCE6D\uCC2C
      \uC544\uB2C8\uC57C. \uAD00\uCC30\uC774\uC57C."
  - minTier: 4
    lines:
    - "\uB124 \uC7A5\uBE44\uB294 \uB0B4\uAC00 \uC81C\uC77C \uBA3C\uC800 \uC190\uBD10.
      \uC21C\uC11C \uAC19\uC740 \uAC70 \uC5C6\uC5B4."
    - "\uB2E4\uCE58\uC9C0 \uB9D0\uACE0 \uC640. \uCD1D\uC740 \uACE0\uCCD0\uB3C4 \uB108\uB294
      \uBABB \uACE0\uCCD0."
    - "\u2026\uADC0 \uB9CC\uC9C0\uC9C0 \uB9C8. \uC544\uB2C8, \uADF8\uB0E5\u2026 \uC9C0\uAE08\uC740
      \uC77C\uD558\uB294 \uC911\uC774\uB2C8\uAE4C."
  idleLines:
  - minTier: 0
    lines:
    - "(\uB4DC\uB974\uB975\u2014 \uC804\uB3D9 \uB4DC\uB77C\uC774\uBC84 \uC18C\uB9AC)"
    - "\uAE30\uB984 \uB0C4\uC0C8 \uC2EB\uC73C\uBA74 \uBC16\uC5D0 \uC788\uC5B4."
    - "\u2026\uC774 \uB098\uC0AC \uC5B4\uB514 \uAC14\uC9C0."
  - minTier: 2
    lines:
    - "\uAC70\uAE30 10\uBC88 \uB80C\uCE58 \uC880. \u2026\uC544, \uACE0\uB9C8\uC6CC."
    - "\uC2E0\uD615 \uCD1D\uC5F4 \uB3C4\uBA74 \uBCF4\uACE0 \uC788\uC5B4. \uC5B8\uC820\uAC00
      \uB9CC\uB4E4\uC5B4 \uBCFC \uAC70\uC57C."
  - minTier: 4
    lines:
    - "(\uAF2C\uB9AC\uAC00 \uB290\uB9AC\uAC8C \uD754\uB4E4\uB9B0\uB2E4) \u2026\uBB58
      \uBD10."
    - "\uB2E4\uC74C \uCD9C\uACA9 \uC804\uC5D0 \uD55C \uBC88 \uB354 \uC810\uAC80\uD558\uC790.
      \uAC19\uC774."
  tierUpLines:
  - minTier: 1
    lines:
    - "\uC774\uB984 \uC678\uC6E0\uC5B4. \uC7A5\uBE44 \uD0DC\uADF8\uC5D0 \uC801\uC5B4
      \uB1A8\uC73C\uB2C8\uAE4C \uC783\uC5B4\uBC84\uB9AC\uC9C0 \uB9C8."
  - minTier: 2
    lines:
    - "\uB124 \uCD1D, \uC774\uC81C \uB0B4\uAC00 \uC81C\uC77C \uC798 \uC54C\uC544.
      \uB108\uBCF4\uB2E4."
  - minTier: 3
    lines:
    - "\uC791\uC5C5\uC2E4 \uBE44\uBC00\uBC88\uD638 \uC54C\uB824 \uC904\uAC8C. \uC0C8\uBCBD\uC5D0
      \uC640\uB3C4 \uB3FC."
  - minTier: 4
    lines:
    - "\u2026\uB2E4\uC74C\uC5D0 \uC0C8 \uCD1D \uB9CC\uB4E4\uBA74, \uC774\uB984\uC740
      \uB124\uAC00 \uC9C0\uC5B4."
  idleInterval: 14
