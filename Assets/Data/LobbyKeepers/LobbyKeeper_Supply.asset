%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f70cd7b2f3a5e61468d00394a718233a, type: 3}
  m_Name: LobbyKeeper_Supply
  m_EditorClassIdentifier: Assembly-CSharp::LobbyKeeperData
  entityId: lobby_supply
  displayName: "\uBCF4\uAE09 \uB2F4\uB2F9"
  visitAffinityGain: 0.5
  greetingLines:
  - minTier: 0
    lines:
    - "\uD544\uC694\uD55C \uBB3C\uAC74 \uC788\uC5B4? \uCC9C\uCC9C\uD788 \uB458\uB7EC\uBD10."
    - "\uC5B4\uC11C \uC640. \uC624\uB298 \uB4E4\uC5B4\uC628 \uAC70 \uC544\uC9C1 \uC815\uB9AC
      \uC911\uC774\uC57C."
    - "\uBCF4\uAE09 \uCC3D\uAD6C \uC5F4\uB824 \uC788\uC5B4. \uBB50 \uCC3E\uC544?"
  - minTier: 2
    lines:
    - "\uC654\uB124. \uB108 \uC624\uB294 \uC2DC\uAC04, \uC774\uC81C \uB300\uCDA9
      \uC54C\uACA0\uB354\uB77C."
    - "\uC624\uB298\uC740 \uC88B\uC740 \uAC70 \uB530\uB85C \uBE7C \uB1A8\uC5B4. \uB18D\uB2F4\uC774\uC57C.
      \uBC18\uCBE4\uC740."
  - minTier: 4
    lines:
    - "\uAE30\uB2E4\uB838\uC5B4. \u2026\uC7A5\uBD80 \uC815\uB9AC\uD558\uB2E4\uAC00.
      \uC9C4\uC9DC\uB85C."
    - "\uC5B4\uC11C \uC640, \uB2E8\uACE8. \uC544\uB2C8, \uADF8 \uC774\uC0C1\uC778\uAC00."
  clickLines:
  - minTier: 0
    lines:
    - "\uB9CC\uC9C0\uC9C0 \uB9C8, \uADF8\uAC74 \uC544\uC9C1 \uAC80\uC218 \uC804\uC774\uC57C."
    - "\uD0C8\uB9B0 \uACC4\uC0B0\uC740 \uC815\uD655\uD558\uAC8C \uD574. \uC678\uC0C1\uC740
      \uC5C6\uC5B4."
    - "\uB098? \uADF8\uB0E5 \uBCF4\uAE09 \uB2F4\uB2F9. \uC774\uB984\uC740 \uC7A5\uBD80\uC5D0
      \uC788\uC796\uC544."
    - "\uD30C\uCE20\uB294 \uC2A4\uD1A0\uB9AC\uAC00 \uC9C4\uD589\uB420 \uB54C\uB9C8\uB2E4
      \uB4E4\uC5B4\uC640. \uC544\uAEF4 \uC368."
  - minTier: 2
    lines:
    - "\uC774 \uC77C \uC624\uB798 \uD588\uC5B4. \uBB3C\uAC74 \uBCF4\uB294 \uB208\uC740
      \uC790\uC2E0 \uC788\uC5B4."
    - "\uCEE4\uD53C \uC0AC \uAC00\uB294 \uAC70, \uB204\uAD6C \uC8FC\uB824\uACE0?
      \u2026\uAD81\uAE08\uD574\uC11C \uBB3B\uB294 \uAC74 \uC544\uB2C8\uACE0."
    - "\uB124\uAC00 \uC0B4\uC544\uC11C \uB3CC\uC544\uC624\uBA74 \uC7A5\uBD80\uAC00
      \uB35C \uBCF5\uC7A1\uD574\uC838. \uADF8\uB7EC\uB2C8\uAE4C \uC0B4\uC544 \uC640."
  - minTier: 4
    lines:
    - "\uB2E4\uC74C \uBCF4\uAE09\uC120 \uC624\uBA74 \uB124 \uBAAB\uBD80\uD130 \uCC59\uACA8
      \uB458\uAC8C."
    - "\uAC00\uB054\uC740 \uADF8\uB0E5 \uC5BC\uAD74 \uBCF4\uB7EC \uC640\uB3C4 \uB3FC.
      \uC548 \uC0AC\uB3C4."
    - "\uB108\uD55C\uD14C\uB9CC \uD558\uB294 \uB9D0\uC778\uB370, \uC774 \uCC3D\uACE0
      \uC5F4\uC1E0 \uD558\uB098 \uB354 \uC788\uC5B4."
  idleLines:
  - minTier: 0
    lines:
    - "(\uC7A5\uBD80\uB97C \uB118\uAE34\uB2E4) \u2026\uACC4\uC0B0\uC774 \uB610 \uC548
      \uB9DE\uB124."
    - "\uC7AC\uACE0 \uD655\uC778 \uC911\uC774\uC57C. \uC2E0\uACBD \uC4F0\uC9C0 \uB9C8."
    - "\uBE44 \uC624\uB294 \uB0A0\uC5D4 \uC0C1\uC790\uAC00 \uB205\uB205\uD574\uC838\uC11C
      \uC2EB\uC5B4."
  - minTier: 2
    lines:
    - "\u2026\uC774\uBC88 \uC8FC \uC785\uACE0\uBD84, \uC0DD\uAC01\uBCF4\uB2E4 \uAD1C\uCC2E\uC740\uB370."
    - "\uB108 \uC9C0\uB09C\uBC88\uC5D0 \uC0B0 \uAC70, \uC798 \uC4F0\uACE0 \uC788\uC5B4?"
  - minTier: 4
    lines:
    - "(\uCF67\uB178\uB798\uB97C \uD765\uC5BC\uAC70\uB9AC\uB2E4 \uBA48\uCD98\uB2E4)
      \u2026\uB4E4\uC5C8\uC5B4? \uBABB \uB4E4\uC740 \uAC78\uB85C \uD574."
    - "\uCC3D\uACE0 \uC815\uB9AC \uB05D\uB098\uBA74 \uCC28\uB77C\uB3C4 \uD55C\uC794\uD560\uB798?"
  tierUpLines:
  - minTier: 1
    lines:
    - "\uC790\uC8FC \uC624\uB124. \uB2E8\uACE8 \uC7A5\uBD80\uC5D0 \uC774\uB984 \uC62C\uB824
      \uB458\uAC8C."
  - minTier: 2
    lines:
    - "\uB108 \uAC19\uC740 \uC190\uB2D8\uC740 \uCC98\uC74C\uC774\uC57C. \uC88B\uC740
      \uB73B\uC73C\uB85C."
  - minTier: 3
    lines:
    - "\uC624\uB298\uC740 \uACC4\uC0B0 \uB05D\uB098\uACE0 \uC880 \uB354 \uC788\uB2E4
      \uAC00. \uD560 \uC598\uAE30\uB294 \uC5C6\uC9C0\uB9CC."
  - minTier: 4
    lines:
    - "\uC774 \uCC3D\uACE0\uC5D0\uC11C \uC81C\uC77C \uC18C\uC911\uD55C \uC7AC\uACE0\uAC00
      \uBB54\uC9C0 \uC54C\uC544? \u2026\uB410\uC5B4, \uBAB0\uB77C\uB3C4 \uB3FC."
  idleInterval: 14
