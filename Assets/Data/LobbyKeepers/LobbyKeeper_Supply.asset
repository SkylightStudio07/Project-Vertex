  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f70cd7b2f3a5e61468d00394a718233a, type: 3}
  m_Name: LobbyKeeper_Supply
  m_EditorClassIdentifier: Assembly-CSharp::LobbyKeeperData
  entityId: lobby_supply
  displayName: "보급 담당"
  visitAffinityGain: 0.5
  greetingLines:
  - minTier: 0
    lines:
    - "기다리고 있었어요! 출발 전에 필요한 건 다… 어라, 재고 목록이 어디 갔죠?"
    - "출발 전에 장비와 물자를 든든히 챙기세요! 가끔 가격표가 거꾸로 붙어 있으니 확인해 주시고요."
    - "한번 출발하면 돌아오기 힘들어요. 깜빡한 건 현장에서 제 동생 토냐가 도와드릴 거예요!"
  clickLines:
  - minTier: 0
    lines:
    - "현장에서 토냐를 만나셨나요? 저랑 같은 흰 가운에 귀마개, 무심한 표정일 거예요."
    - "그 무심한 말투에 말랑한 볼살… 볼에 얼굴을 부비고 싶다니까요! 앗, 못 들은 척 해주세요!"
  idleLines:
  - minTier: 0
    lines:
    - "토냐는 잘 지내고 있을까요? 만나시면 언니가 많이 사랑한다고 전해 주세요!"
  tierUpLines: []
  idleInterval: 14
