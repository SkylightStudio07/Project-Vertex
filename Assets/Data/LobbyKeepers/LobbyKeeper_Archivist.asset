%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f70cd7b2f3a5e61468d00394a718233a, type: 3}
  m_Name: LobbyKeeper_Archivist
  m_EditorClassIdentifier: Assembly-CSharp::LobbyKeeperData
  entityId: lobby_archivist
  displayName: "\uAE30\uB85D\uAD00 \uB2F4\uB2F9"
  visitAffinityGain: 0.5
  greetingLines:
  - minTier: 0
    lines:
    - "\uC5B4\uB5A4 \uC774\uC57C\uAE30\uB97C \uD3BC\uCCD0 \uBCFC\uAE4C\uC694?"
    - "\uC5B4\uC11C \uC624\uC138\uC694. \uAE30\uB85D\uB4E4\uC740 \uC624\uB298\uB3C4
      \uC58C\uC804\uD788 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB2F5\uB2C8\uB2E4."
    - "\uBC1C\uC18C\uB9AC\uAC00 \uB4E4\uB824\uC11C \uC54C\uC558\uC5B4\uC694. \uB2F9\uC2E0\uC774\uAD70\uC694."
  - minTier: 2
    lines:
    - "\uC624\uC168\uB124\uC694. \uB9C8\uCE68 \uB2F9\uC2E0 \uAE30\uB85D\uC744 \uB118\uACA8
      \uBCF4\uB358 \uCC38\uC774\uC5C8\uC5B4\uC694."
    - "\uB098\uBE44\uB4E4\uC774 \uBA3C\uC800 \uC54C\uC544\uCC44\uB354\uAD70\uC694.
      \uB2F9\uC2E0\uC774 \uC628\uB2E4\uB294 \uAC78."
  - minTier: 4
    lines:
    - "\uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC5B4\uC694. \uC774\uBC88 \uC7A5\uC740
      \uB2F9\uC2E0\uACFC \uD568\uAED8 \uB118\uAE30\uACE0 \uC2F6\uC5C8\uAC70\uB4E0\uC694."
    - "\uC5B4\uC11C \uC640\uC694. \uC5EC\uAE34 \uC5B8\uC81C\uB098 \uB2F9\uC2E0 \uC790\uB9AC\uB97C
      \uBE44\uC6CC \uB450\uACE0 \uC788\uB2F5\uB2C8\uB2E4."
  clickLines:
  - minTier: 0
    lines:
    - "\uCC45\uC7A5\uC740 \uC870\uC2EC\uD788\uC694. \uC624\uB798\uB41C \uAE30\uB85D\uC740
      \uC27D\uAC8C \uBC14\uC2A4\uB7EC\uC9C0\uAC70\uB4E0\uC694."
    - "\uC774 \uB098\uBE44\uB4E4\uC774\uC694? \uAE30\uB85D\uC5D0\uC11C \uD758\uB7EC\uB098\uC628
      \uAC83\uB4E4\uC774\uB78D\uB2C8\uB2E4."
    - "\uC4F0\uB7EC\uB728\uB9B0 \uAC83\uB4E4\uC758 \uC774\uB984\uB3C4, \uC5EC\uAE30\uC120
      \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uC544\uC694."
    - "\uC5EC\uC6B0\uB294 \uBB3C\uC9C0 \uC54A\uC544\uC694. \u2026\uC544\uB9C8\uB3C4\uC694."
  - minTier: 2
    lines:
    - "\uAE30\uB85D\uC740 \uAC70\uC9D3\uB9D0\uC744 \uD558\uC9C0 \uC54A\uC544\uC694.
      \uAE30\uB85D\uD558\uB294 \uC0AC\uB78C\uC740 \uAC00\uB054 \uD558\uC9C0\uB9CC\uC694."
    - "\uB2F9\uC2E0\uC774 \uC9C0\uB098\uC628 \uCE35\uC218\uB97C \uC138\uC5B4 \uBCF4\uC558\uC5B4\uC694.
      \uAF64 \uBA40\uB9AC \uC654\uB124\uC694."
    - "\uAD81\uAE08\uD55C \uAC8C \uC788\uC73C\uBA74 \uBB3C\uC5B4\uBCF4\uC138\uC694.
      \uB300\uB2F5\uC740\u2026 \uAE30\uBD84\uC5D0 \uB530\uB77C \uB2E4\uB974\uACA0\uC9C0\uB9CC."
  - minTier: 4
    lines:
    - "\uB2F9\uC2E0 \uC774\uC57C\uAE30\uB9CC\uC740 \uB2E4\uB978 \uCC45\uC7A5\uC5D0
      \uAF42\uC544 \uB450\uC5C8\uC5B4\uC694. \uBE44\uBC00\uC774\uC5D0\uC694."
    - "\uC5B8\uC820\uAC00 \uB2F9\uC2E0 \uAE30\uB85D\uC758 \uB9C8\uC9C0\uB9C9 \uC7A5\uC744
      \uC81C\uAC00 \uC4F0\uAC8C \uB418\uACA0\uC8E0. \uADF8\uB0A0\uC774 \uB2A6\uAC8C
      \uC624\uAE30\uB97C."
    - "\u2026\uAC00\uAE4C\uC774 \uC624\uC168\uB124\uC694. \uB098\uBE44\uAC00 \uB180\uB77C\uC796\uC544\uC694.
      \uC800\uB3C4\uC694."
  idleLines:
  - minTier: 0
    lines:
    - "(\uCC45\uC7A5\uC744 \uB118\uAE30\uB294 \uC18C\uB9AC)"
    - "\uC789\uD06C \uB9C8\uB974\uB294 \uB0C4\uC0C8, \uC88B\uC544\uD558\uC138\uC694?"
    - "\u2026\uC774 \uD398\uC774\uC9C0, \uB204\uAC00 \uC811\uC5B4 \uB193\uC558\uC744\uAE4C\uC694."
  - minTier: 2
    lines:
    - "(\uB098\uBE44 \uD55C \uB9C8\uB9AC\uAC00 \uC5B4\uAE68\uC5D0 \uC549\uC558\uB2E4
      \uB0A0\uC544\uAC04\uB2E4)"
    - "\uC624\uB298 \uB4E4\uC5B4\uC628 \uAE30\uB85D\uC774 \uAF64 \uB9CE\uB124\uC694.
      \uB2F9\uC2E0 \uB355\uBD84\uC774\uC5D0\uC694."
  - minTier: 4
    lines:
    - "(\uAF2C\uB9AC\uB85C \uBC14\uB2E5\uC744 \uD1A1 \uCE5C\uB2E4) \u2026\uC9C0\uB8E8\uD55C
      \uAC8C \uC544\uB2C8\uB77C, \uAE30\uBD84\uC774 \uC88B\uC740 \uAC70\uC608\uC694."
    - "\uC870\uC6A9\uD55C \uC2DC\uAC04\uB3C4 \uC88B\uB124\uC694. \uB2F9\uC2E0\uC774
      \uC788\uC73C\uBA74."
  tierUpLines:
  - minTier: 1
    lines:
    - "\uB2F9\uC2E0 \uC774\uB984\uC744 \uC0C9\uC778\uC5D0 \uC62C\uB838\uC5B4\uC694.
      \uC774\uC81C \uC190\uB2D8\uC774 \uC544\uB2C8\uB77C \uC5F4\uB78C\uC790\uB78D\uB2C8\uB2E4."
  - minTier: 2
    lines:
    - "\uB098\uBE44\uB4E4\uC774 \uB2F9\uC2E0\uC744 \uAE30\uC5B5\uD558\uAE30 \uC2DC\uC791\uD588\uC5B4\uC694."
  - minTier: 3
    lines:
    - "\uC11C\uACE0 \uC548\uCABD \uBC29, \uBCF4\uC5EC \uB4DC\uB9B4\uAE4C\uC694? \uC544\uBB34\uC5D0\uAC8C\uB098
      \uBCF4\uC5EC \uC8FC\uC9C4 \uC54A\uAC70\uB4E0\uC694."
  - minTier: 4
    lines:
    - "\uB2F9\uC2E0\uC5D0 \uAD00\uD55C \uAE30\uB85D\uC740 \uC774\uC81C \uC81C\uAC00
      \uC9C1\uC811 \uC368\uC694. \uC544\uBB34\uB3C4 \uBABB \uC77D\uAC8C."
  idleInterval: 14
