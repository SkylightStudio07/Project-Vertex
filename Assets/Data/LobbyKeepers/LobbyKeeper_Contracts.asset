--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f70cd7b2f3a5e61468d00394a718233a, type: 3}
  m_Name: LobbyKeeper_Contracts
  m_EditorClassIdentifier: Assembly-CSharp::LobbyKeeperData
  entityId: lobby_contracts
  displayName: 편재의 유리아
  visitAffinityGain: 0.5
  greetingLines:
  - minTier: 0
    lines:
    - "\uC5B4\uBA38, \uC624\uC168\uB124\uC694. \uC624\uB298\uC740 \uC5B4\uB5A4 \uC791\uC804\uC73C\uB85C
      \uACE0\uC0DD\uD574 \uBCF4\uC2E4\uB798\uC694?"
    - "\uAC8C\uC774\uD2B8 \uC5F4\uC5B4 \uB480\uC5B4\uC694. \uB3C4\uB9DD\uCE58\uC2E4
      \uAC70\uBA74 \uC9C0\uAE08\uC774 \uB9C8\uC9C0\uB9C9 \uAE30\uD68C\uC608\uC694.
      \uB18D\uB2F4\uC774\uC5D0\uC694."
    - "\uD0D0\uC0AC\uC790\uB2D8 \uC624\uC168\uB2E4. \u2026\uC544, \uD63C\uC7A3\uB9D0\uC774\uC5D0\uC694.
      \uC2E0\uACBD \uC4F0\uC9C0 \uB9C8\uC138\uC694."
  - minTier: 2
    lines:
    - "\uB610 \uC624\uC168\uB124\uC694? \uC800 \uBCF4\uB7EC \uC624\uC2E0 \uAC74 \uC544\uB2C8\uC8E0?
      \u2026\uC544\uB2C8\uBA74 \uB9D0\uACE0\uC694."
    - "\uD0D0\uC0AC\uC790\uB2D8 \uC55E\uC73C\uB85C \uB4E4\uC5B4\uC628 \uC9C0\uBA85
      \uC791\uC804, \uB530\uB85C \uBE7C \uB480\uC5B4\uC694. \uACE0\uB9C8\uC6B0\uBA74
      \uCEE4\uD53C \uD55C \uC794\uC774\uC694."
  - minTier: 4
    lines:
    - "\uAE30\uB2E4\uB838\uB0D0\uACE0\uC694? \uC124\uB9C8\uC694. \u2026\uC2DC\uACC4\uB294
      \uC138 \uBC88\uBC16\uC5D0 \uC548 \uBD24\uC5B4\uC694."
    - "\uC774 \uB370\uD06C\uC5D0\uC11C \uC81C\uC77C \uBBFF\uB294 \uD0D0\uC0AC\uC790\uB2D8.
      \uC774\uAC74 \uC544\uBB34\uD55C\uD14C\uB3C4 \uB9D0\uD558\uBA74 \uC548 \uB3FC\uC694?"
  clickLines:
  - minTier: 0
    lines:
    - "\uC548\uACBD \uCCD0\uB2E4\uBCF4\uC2DC\uB294 \uAC70 \uB2E4 \uBCF4\uC5EC\uC694.
      \uB80C\uC988\uC5D0 \uBE44\uCE58\uAC70\uB4E0\uC694."
    - "\uD0DC\uBE14\uB9BF \uBCF4\uC5EC \uB4DC\uB9B4 \uC218\uB294 \uC788\uB294\uB370,
      \uADF8\uB7FC \uC11C\uBA85\uD558\uC154\uC57C \uB3FC\uC694. \uC885\uC2E0 \uACC4\uC57D\uC73C\uB85C\uC694."
    - "\uC704\uC57D \uC870\uD56D\uC740 \uC791\uAC8C \uC368 \uB480\uC5B4\uC694. \uB3CB\uBCF4\uAE30
      \uBE4C\uB824 \uB4DC\uB9B4\uAE4C\uC694?"
    - "\uC758\uB8B0\uCC98 \uC815\uBCF4\uB294 \uBE44\uBC00\uC774\uC5D0\uC694. \uADF8\uB807\uAC8C
      \uCCD0\uB2E4\uBD10\uB3C4 \uC548 \uB3FC\uC694."
  - minTier: 2
    lines:
    - "\uD0D0\uC0AC\uC790\uB2D8 \uBCF4\uACE0\uC11C\uB294 \uC624\uD0C0\uAE4C\uC9C0
      \uB2E4 \uC77D\uC5B4\uC694. \uBE68\uAC04 \uD39C\uC73C\uB85C \uD45C\uC2DC\uD574\uC11C
      \uB3CC\uB824 \uB4DC\uB9B4\uAE4C\uC694?"
    - "\uD604\uC7A5 \uC0AC\uC9C4 \uD55C \uC7A5\uB9CC \uCC0D\uC5B4\uB2E4 \uC8FC\uC138\uC694.
      \uD0D0\uC0AC\uC790\uB2D8 \uC5BC\uAD74 \uB098\uC628 \uAC78\uB85C\uC694. \uC11C\uB958\uC6A9\uC774\uC5D0\uC694,
      \uC11C\uB958\uC6A9."
    - "\uC774 \uC870\uB07C\uC694? \uADDC\uC815\uC0C1 \uCC29\uC6A9\uC774\uC5D0\uC694.
      \u2026\uC5B4\uC6B8\uB9B0\uB2E4\uACE0 \uD574 \uC8FC\uBA74 \uACC4\uC18D \uC785\uC744\uAC8C\uC694."
  - minTier: 4
    lines:
    - "\uB2E4\uC74C \uC791\uC804\uC740 \uC81C\uAC00 \uACE8\uB77C \uB4DC\uB9B4\uAC8C\uC694.
      \uBCF4\uC218 \uB9D0\uACE0, \uD0D0\uC0AC\uC790\uB2D8 \uBB34\uC0AC\uD788 \uB3CC\uC544\uC624\uB294
      \uAE30\uC900\uC73C\uB85C\uC694."
    - "\uB370\uD06C \uBD88 \uAEBC\uC9C4 \uB4A4\uC5D0\uB3C4 \uC800 \uC5EC\uAE30 \uC788\uC744
      \uB54C\uAC00 \uC788\uC5B4\uC694. \uCC3E\uC544\uC624\uB77C\uB294 \uB73B\uC740\u2026
      \uC544\uB2D0 \uC218\uB3C4 \uC788\uACE0\uC694."
    - "ID \uCE74\uB4DC \uB4B7\uBA74\uC774 \uAD81\uAE08\uD558\uC8E0? \uAD81\uAE08\uD574\uD558\uB294
      \uC5BC\uAD74\uC774 \uB354 \uC7AC\uBC0C\uC5B4\uC11C \uC548 \uC54C\uB824 \uB4DC\uB9B4\uB798\uC694."
  idleLines:
  - minTier: 0
    lines:
    - "(\uD0DC\uBE14\uB9BF\uC744 \uD1A1\uD1A1 \uB450\uB4DC\uB9B0\uB2E4) \u2026\uC774
      \uC758\uB8B0\uCC98, \uB610 \uC120\uAE08\uC744 \uC548 \uB123\uC5C8\uB124. \uC774\uC790
      \uBD99\uC5EC\uC57C\uC9C0."
    - "\uAC8C\uC774\uD2B8 \uC678\uAE30 \uC601\uD558 12\uB3C4. \uD0D0\uC0AC\uC790\uB2D8
      \uC190 \uC2DC\uB9AC\uACA0\uB2E4, \uD6C4\uD6C4."
    - "(\uC548\uACBD \uB108\uBA38\uB85C \uD790\uB054 \uBCF8\uB2E4) \u2026\uC544\uC9C1
      \uACC4\uC168\uC5B4\uC694?"
  - minTier: 2
    lines:
    - "\uD0D0\uC0AC\uC790\uB2D8\uC774 \uB2E4\uB140\uC628 \uAD6C\uC5ED\uC5D4 \uD45C\uC2DC
      \uB530\uB85C \uD574 \uB480\uC5B4\uC694. \uBB34\uC2A8 \uD45C\uC2DC\uB0D0\uACE0\uC694?
      \uBE44\uBC00\uC774\uC5D0\uC694."
    - "\uCEE4\uD53C\u2026 \uC544, \uD0D0\uC0AC\uC790\uB2D8 \uBAAB\uC740 \uC5C6\uC5B4\uC694.
      \uC81C \uAC70\uC608\uC694."
  - minTier: 4
    lines:
    - "(\uD39C\uC744 \uB3CC\uB9AC\uB2E4 \uBA48\uCD98\uB2E4) \u2026\uB3CC\uC544\uC624\uB294
      \uC2DC\uAC04, \uC774\uC81C \uB300\uCDA9 \uB9DE\uD600\uC694. \uC624\uB298\uC740
      \uC880 \uB2A6\uC73C\uC168\uB124\uC694?"
    - "\uC774 \uB370\uD06C\uC5D0\uC11C \uBC30\uC6C5\uD55C \uD0D0\uC0AC\uC790\uB294
      \uB9CE\uC740\uB370, \uB180\uB9AC\uB294 \uB9DB\uC774 \uC788\uB294 \uAC74 \uD0D0\uC0AC\uC790\uB2D8\uBFD0\uC774\uC5D0\uC694."
  tierUpLines:
  - minTier: 1
    lines:
    - "\uCD9C\uACA9 \uAE30\uB85D \uC313\uC600\uB124\uC694. \uC774\uC81C \uBC88\uD638\uD45C
      \uC548 \uBF51\uC73C\uC154\uB3C4 \uB3FC\uC694. \uD2B9\uBCC4 \uB300\uC6B0, \uBD80\uB7FD\uC8E0?"
  - minTier: 2
    lines:
    - "\uC804\uB2F4 \uC791\uC804\uAD00\uC73C\uB85C \uC9C0\uC815\uD574 \uB4DC\uB9B4\uAC8C\uC694.
      \uD2B9\uC804\uC740\u2026 \uC81C \uC794\uC18C\uB9AC \uBB34\uC81C\uD55C\uC774\uC694."
  - minTier: 3
    lines:
    - "\uC9C0\uBA85 \uC791\uC804 \uAD8C\uD55C \uC5F4\uC5C8\uC5B4\uC694. \uD0D0\uC0AC\uC790\uB2D8
      \uC774\uB984 \uB4E4\uC5B4\uC624\uBA74 \uC81C\uC77C \uBA3C\uC800 \uC54C\uB824
      \uB4DC\uB9B4\uAC8C\uC694. \uC81C\uC77C \uBA3C\uC800 \uB180\uB9AC\uAE30\uB3C4
      \uD558\uACE0\uC694."
  - minTier: 4
    lines:
    - "\uC81C \uD3C9\uAC00\uD45C\uC5D0\uC11C \uD0D0\uC0AC\uC790\uB2D8 \uC904\uB9CC
      \uC0C9\uC774 \uB2EC\uB77C\uC694. \uADDC\uC815 \uC704\uBC18\uC774\uC5D0\uC694.
      \uBE44\uBC00, \uC9C0\uCF1C \uC8FC\uC2E4 \uAC70\uC8E0?"
  idleInterval: 14
