%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1ea57348c810fcd459e714d3667d8635, type: 3}
  m_Name: Shopkeeper_Tonya
  m_EditorClassIdentifier: Assembly-CSharp::ShopkeeperData
  entityId: tonya
  entityName: "\uD1A0\uB0D0"
  portrait: {fileID: 21300000, guid: bc3e16b7ce972a04ab678a3dbfb9e945, type: 3}
  affiliation: "VERTEX / \uC0C1\uC810 \uC8FC\uC778"
  themeColor: {r: 0.78, g: 0.62, b: 0.32, a: 1}
  chapter: 1
  visitAffinityGain: 0.5
  visitSequences:
  - sequenceId: tonya_first_meet
    priority: 100
    minAffinity: 0
    maxAffinity: 999
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: tonya_met
    setEventFlagOnComplete: tonya_met
    steps:
    - speakerName: 
      npcDialogue: "\u2026\u2026\uC544. \uC190\uB2D8\uC778 \uAC70\uC5D0\uC694. \uC774
        \uAD6C\uC5ED\uAE4C\uC9C0 \uAC78\uC5B4\uC11C \uC628 \uC0AC\uB78C\uC740 \uC624\uB79C\uB9CC\uC778
        \uAC70\uC5D0\uC694."
      playerAnswerText: 
      speakerAvatar: {fileID: 0}
    - speakerName: 
      npcDialogue: "\uD1A0\uB0D0\uC778 \uAC70\uC5D0\uC694. \uC774 \uCE35 \uBCF4\uAE09\uC18C\uB97C
        \uB9E1\uACE0 \uC788\uB294 \uAC70\uC5D0\uC694. \uB9CC\uB098\uC11C \uBC18\uAC00\uC6B4
        \uAC70\uC5D0\uC694."
      playerAnswerText: 
      speakerAvatar: {fileID: 0}
    - speakerName: 
      npcDialogue: "\uADF8\uCABD\uC740\u2026 \uAD00\uCE21 \uAE30\uB85D\uC5D0 \uC5C6\uB294
        \uC5BC\uAD74\uC778 \uAC70\uC5D0\uC694. \uBC29\uB791\uC790, \uB9DE\uB294 \uAC70\uC5D0\uC694?"
      playerAnswerText: 
      speakerAvatar: {fileID: 0}
    - speakerName: 
      npcDialogue: "\uAD1C\uCC2E\uC740 \uAC70\uC5D0\uC694, \uCE90\uBB3B\uC9C0\uB294
        \uC54A\uC744 \uAC70\uC5D0\uC694. \uD06C\uB808\uB527\uB9CC \uC788\uC73C\uBA74
        \uB204\uAD6C\uB4E0 \uC190\uB2D8\uC778 \uAC70\uC5D0\uC694."
      playerAnswerText: 
      speakerAvatar: {fileID: 0}
    - speakerName: 
      npcDialogue: "\uD544\uC694\uD55C \uAC8C \uC788\uC73C\uBA74 \uCC9C\uCC9C\uD788
        \uACE8\uB77C \uBCF4\uB294 \uAC70\uC5D0\uC694."
      playerAnswerText: 
      speakerAvatar: {fileID: 0}
  - sequenceId: tonya_tier1_event
    priority: 50
    minAffinity: 2
    maxAffinity: 999
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: tonya_tier1
    setEventFlagOnComplete: tonya_tier1
    steps:
    - speakerName: 
      npcDialogue: "\u2026\uC800\uAE30, \uBC29\uB791\uC790. \uC7A0\uAE50 \uC2DC\uAC04
        \uC788\uB294 \uAC70\uC5D0\uC694?"
      playerAnswerText: "[\uBC29\uB791\uC790] \uBB34\uC2A8 \uC77C\uC774\uC57C?"
      speakerAvatar: {fileID: 0}
    - speakerName: 
      npcDialogue: "\uB9E4\uBC88 \uC0B4\uC544\uC11C \uB3CC\uC544\uC624\uB294 \uAC70\uC5D0\uC694.
        \uAE30\uB85D\uB300\uB85C\uB77C\uBA74 \uBC8C\uC368 \uC0AC\uB77C\uC84C\uC5B4\uC57C
        \uD558\uB294 \uD655\uB960\uC778 \uAC70\uC5D0\uC694."
      playerAnswerText: "[\uBC29\uB791\uC790] \uC6B4\uC774 \uC88B\uC558\uC744 \uBFD0\uC774\uC57C."
      speakerAvatar: {fileID: 0}
    - speakerName: 
      npcDialogue: "\u2026\u2026\uADF8\uB7FC \uADF8 \uC6B4, \uD1A0\uB0D0\uB3C4 \uC870\uAE08
        \uBBFF\uC5B4 \uBCF4\uB294 \uAC70\uC5D0\uC694. \uB2E4\uC74C\uC5D0\uB3C4 \uAF2D
        \uB4E4\uB974\uB294 \uAC70\uC5D0\uC694."
      playerAnswerText: "[\uBC29\uB791\uC790] \uC57D\uC18D\uD560\uAC8C."
      speakerAvatar: {fileID: 0}
  - sequenceId: tonya_greet_t1
    priority: 1
    minAffinity: 2
    maxAffinity: 999
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: 
      npcDialogue: "\uB610 \uC628 \uAC70\uC5D0\uC694. \u2026\uBB34\uC0AC\uD574\uC11C
        \uB2E4\uD589\uC778 \uAC70\uC5D0\uC694."
      playerAnswerText: 
      speakerAvatar: {fileID: 0}
  - sequenceId: tonya_greet_default
    priority: 0
    minAffinity: 0
    maxAffinity: 999
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: 
      npcDialogue: "\uC5B4\uC11C \uC624\uB294 \uAC70\uC5D0\uC694. \uC624\uB298\uB3C4
        \uBCF4\uAE09\uC18C\uB294 \uC5F4\uB824 \uC788\uB294 \uAC70\uC5D0\uC694."
      playerAnswerText: 
      speakerAvatar: {fileID: 0}
  greetingLine: "\uD544\uC694\uD55C \uAC8C \uC788\uB294 \uAC70\uC5D0\uC694?"
  idleLines:
  - "\uCC9C\uCC9C\uD788 \uBCF4\uB294 \uAC70\uC5D0\uC694. \uB3C4\uB9DD \uC548 \uAC00\uB294
    \uAC70\uC5D0\uC694."
  - "\uC624\uB298\uC740 \uC785\uACE0\uAC00 \uAD1C\uCC2E\uC740 \uD3B8\uC778 \uAC70\uC5D0\uC694."
  - "\uD06C\uB808\uB527\uC774 \uBAA8\uC790\uB77C\uBA74\u2026 \uC5B4\uCA54 \uC218
    \uC5C6\uB294 \uAC70\uC5D0\uC694."
  - "\uAD6C\uACBD\uB9CC \uD558\uACE0 \uC548 \uC0AC\uB294 \uAC74 \uACE4\uB780\uD55C
    \uAC70\uC5D0\uC694."
  - "\uC88B\uC740 \uC120\uD0DD\uC774 \uB418\uAE38 \uBC14\uB77C\uB294 \uAC70\uC5D0\uC694."
  clickLines:
  - "\u2026\uC65C \uC790\uAFB8 \uCC0C\uB974\uB294 \uAC70\uC5D0\uC694?"
  - "\uADF8\uAC74 \uD1A0\uB0D0\uAC00 \uC9C1\uC811 \uC810\uAC80\uD55C \uBB3C\uAC74\uC778
    \uAC70\uC5D0\uC694."
  - "\uD1A0\uB0D0\uB294 \uC9C0\uAE08 \uBC14\uC05C \uAC70\uC5D0\uC694."
  - "\uAD81\uAE08\uD55C \uAC8C \uC788\uB294 \uAC70\uC5D0\uC694?"
  purchaseLines:
  - "\uAC70\uB798 \uC131\uB9BD\uC778 \uAC70\uC5D0\uC694."
  - "\uC88B\uC740 \uC120\uD0DD\uC778 \uAC70\uC5D0\uC694."
  - "\uC798 \uC4F0\uB294 \uAC70\uC5D0\uC694. \uACE0\uC7A5 \uB098\uBA74 \uB2E4\uC2DC
    \uC624\uB294 \uAC70\uC5D0\uC694."
  - "\u2026\uD1A0\uB0D0\uB3C4 \uADF8\uAC70 \uC88B\uC544\uD558\uB294 \uAC70\uC5D0\uC694."
  idleInterval: 12
  farewellLines:
  - minTier: 0
    lines:
    - "\uC798 \uB2E4\uB140\uC624\uB294 \uAC70\uC5D0\uC694."
    - "\uB2E4\uC74C\uC5D0 \uB610 \uC624\uB294 \uAC70\uC5D0\uC694. \uC678\uC0C1\uC740
      \uC548 \uBC1B\uB294 \uAC70\uC5D0\uC694."
    - "\uC0B4\uC544\uC11C \uB3CC\uC544\uC624\uB294 \uAC70\uC5D0\uC694. \uB2E8\uACE8\uC740
      \uADC0\uD55C \uAC70\uC5D0\uC694."
  - minTier: 1
    lines:
    - "\uC798 \uB2E4\uB140\uC624\uB294 \uAC70\uC5D0\uC694. \u2026\u2026\uB2E4\uCE58\uC9C0\uB294
      \uB9D0\uACE0."
    - "\uB2E4\uC74C \uCE35\uB3C4 \uC870\uC2EC\uD558\uB294 \uAC70\uC5D0\uC694. \uBB3C\uAC74
      \uB5A8\uC5B4\uC9C0\uBA74 \uB610 \uC624\uB294 \uAC70\uC5D0\uC694."
    - "\uD1A0\uB0D0\uB294 \uC5EC\uAE30 \uC788\uB294 \uAC70\uC5D0\uC694. \uD544\uC694\uD558\uBA74
      \uB610 \uB4E4\uB974\uB294 \uAC70\uC5D0\uC694."
  - minTier: 2
    lines:
    - "\uBB34\uB9AC\uD558\uC9C0 \uC54A\uB294 \uAC70\uC5D0\uC694. \uD1A0\uB0D0\uB791
      \uC57D\uC18D\uD55C \uAC70\uC5D0\uC694."
    - "\uC798 \uB2E4\uB140\uC624\uB294 \uAC70\uC5D0\uC694, \uBC29\uB791\uC790. \u2026\u2026\uB3CC\uC544\uC624\uBA74
      \uCC28 \uC815\uB3C4\uB294 \uB053\uC5EC \uB450\uB294 \uAC70\uC5D0\uC694."
    - "\uAC00\uBC29 \uB2E4\uC2DC \uD655\uC778\uD558\uB294 \uAC70\uC5D0\uC694. \uBE60\uB728\uB9B0
      \uAC70 \uC788\uC73C\uBA74 \uACE4\uB780\uD55C \uAC70\uC5D0\uC694."
  - minTier: 3
    lines:
    - "\uBC8C\uC368 \uAC00\uB294 \uAC70\uC5D0\uC694? \u2026\u2026\uC870\uAE08\uB9CC
      \uB354 \uC788\uB2E4 \uAC00\uB3C4 \uB418\uB294 \uAC70\uC5D0\uC694."
    - "\uD1A0\uB0D0\uB294 \uC5EC\uAE30\uC11C \uAE30\uB2E4\uB9AC\uB294 \uAC70\uC5D0\uC694.
      \uAF2D \uB3CC\uC544\uC624\uB294 \uAC70\uC5D0\uC694."
    - "\uBC29\uB791\uC790 \uBAAB\uC740 \uB530\uB85C \uCC59\uACA8 \uB450\uB294 \uAC70\uC5D0\uC694.
      \uADF8\uB7EC\uB2C8\uAE4C \uAF2D \uC624\uB294 \uAC70\uC5D0\uC694."
  - minTier: 4
    lines:
    - "\uC798 \uB2E4\uB140\uC624\uB294 \uAC70\uC5D0\uC694. \u2026\u2026\uD1A0\uB0D0\uAC00
      \uC81C\uC77C \uBA3C\uC800 \uB9C8\uC911 \uB098\uAC00\uB294 \uAC70\uC5D0\uC694."
    - "\uBC29\uB791\uC790\uAC00 \uC5C6\uC73C\uBA74 \uC774 \uAC00\uAC8C\uB3C4 \uC2EC\uC2EC\uD55C
      \uAC70\uC5D0\uC694. \uADF8\uB7EC\uB2C8\uAE4C, \uAF2D \uB3CC\uC544\uC624\uB294
      \uAC70\uC5D0\uC694."
    - "\uB2E4\uB140\uC624\uB294 \uAC70\uC5D0\uC694. \uD1A0\uB0D0\uB294 \uBC29\uB791\uC790\uB97C
      \uBBFF\uB294 \uAC70\uC5D0\uC694."
