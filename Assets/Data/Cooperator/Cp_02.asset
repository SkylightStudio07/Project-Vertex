  campSprite: {fileID: 0}
  campActivity: "\uCC3D \uB05D \uD68C\uC218 \uC7A5\uCE58 \uC810\uAC80 \uC911"
  campLines:
  - "\uC6A9\uAC74\uC740 \uC9E7\uAC8C. \uC138 \uBB38\uC7A5 \uB118\uC5B4\uAC00\uBA74
    \uC548 \uB4E4\uC5B4."
  - "\uBC25? \uBC8C\uC368 \uBA39\uC5C8\uC5B4. 2\uBD84 \uAC78\uB838\uB098."
  - "\uC5B4\uC81C \uBCF8 \uC601\uD654? 3\uBC30\uC18D\uC73C\uB85C \uBD24\uC5B4. \uACB0\uB9D0\uC740
    \uC608\uC0C1\uB300\uB85C\uC600\uACE0."
  - "\uCC3D\uC740 \uC9E7\uC544\uB3C4 \uB3FC. \uB9DE\uD788\uBA74 \uB418\uB2C8\uAE4C."
  - "(\uC190\uBAA9 \uC7A5\uCE58\uB97C \uB2F9\uACBC\uB2E4 \uB193\uB294\uB2E4) \u2026\uD68C\uC218
    \uC7A5\uCE58, \uC774\uC0C1 \uC5C6\uC74C."
  - "\uBC29\uD328\uAC00 \uD06C\uB2E4\uACE0? \uAC11\uC637 \uB300\uC2E0\uC774\uC57C.
    \uC5B4\uCC28\uD53C \uC548 \uB9DE\uAC70\uB4E0."
  restArrivalLines:
  - minCoopLevel: 0
    lines:
    - "\uC270\uB2E4\uACE0? \u202610\uBD84. \uADF8 \uC774\uC0C1\uC740 \uB454\uD574\uC838."
    - "\uC5EC\uAE30\uC11C \uC815\uBE44\uD558\uACE0 \uBC14\uB85C \uCD9C\uBC1C\uD558\uC790."
    - "\uB9DD\uC740 \uB0B4\uAC00 \uBD10. \uB208\uC740 \uC88B\uC73C\uB2C8\uAE4C."
  - minCoopLevel: 2
    lines:
    - "\uC880 \uC549\uC544. \uB2E4\uC74C \uC804\uD22C \uB3D9\uC120\uC740 \uB0B4\uAC00
      \uC9DC \uB458\uAC8C."
    - "\u2026\uB108 \uAC77\uB294 \uC18D\uB3C4, \uC774\uC81C \uC880 \uB9DE\uCDB0 \uC904
      \uB9CC\uD574\uC84C\uC5B4."
  - minCoopLevel: 3
    lines:
    - "\uC624\uB298\uC740\u2026 \uCC9C\uCC9C\uD788 \uC26C\uC5B4\uB3C4 \uB3FC. \uC774\uC0C1\uD558\uAC8C
      \uADF8\uB7EC\uACE0 \uC2F6\uB124."
    - "\uC606\uC5D0 \uC788\uC744\uAC8C. \uBE68\uB9AC \uB05D\uB0BC \uC0DD\uAC01 \uC5C6\uC774."
