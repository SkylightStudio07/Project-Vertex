  sequences:
  - sequenceId: karina_t0
    priority: 0
    minAffinity: 0
    maxAffinity: 1.99
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: 
      npcDialogue: "\u2026\uC3D8\uC9C0 \uB9C8. \uC774\uBBF8 \uC84C\uC73C\uB2C8\uAE4C."
      playerAnswerText: "[\uD0D0\uC0AC\uC790] \uBA3C\uC800 \uC3DC \uAC74 \uADF8\uCABD\uC774\uC57C."
      speakerAvatar: {fileID: 0}
    - speakerName: 
      npcDialogue: "\uBBF8\uAD6D \uB0C4\uC0C8\uAC00 \uB0AC\uAC70\uB4E0. \uADF8\uAC83\uBFD0\uC774\uC57C.
        \u2026\uB2E4\uC74C\uC5D4 \uC548 \uC838."
      playerAnswerText: "[\uD0D0\uC0AC\uC790] ..."
      speakerAvatar: {fileID: 0}
  - sequenceId: karina_t1
    priority: 1
    minAffinity: 2
    maxAffinity: 3.99
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: 
      npcDialogue: "\uB610 \uB108\uC57C? \uCC3D\uACE0 \uBB38\uC744 \uB450\uB4DC\uB9AC\uB294
        \uB188\uB4E4\uC740 \uBCF4\uD1B5 \uB450 \uBC88 \uC548 \uC640."
      playerAnswerText: "[\uD0D0\uC0AC\uC790] \uC9C0\uB098\uAC00\uB294 \uAE38\uC774\uC5C8\uC5B4."
      speakerAvatar: {fileID: 0}
    - speakerName: 
      npcDialogue: "\uAC70\uC9D3\uB9D0. \u2026\uADF8\uB798\uB3C4 \uBC18\uB3D9 \uC7A1\uB294
        \uBC95\uC740 \uB298\uC5C8\uB124."
      playerAnswerText: "[\uD0D0\uC0AC\uC790] ..."
      speakerAvatar: {fileID: 0}
  - sequenceId: karina_t2
    priority: 2
    minAffinity: 4
    maxAffinity: 5.99
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: 
      npcDialogue: "\uC774 \uCC3D\uACE0, \uC0DD\uAC01\uBCF4\uB2E4 \uC870\uC6A9\uD558\uC9C0?
        \uB098 \uB9D0\uACE0\uB294 \uB2E4 \uC8FD\uC5C8\uAC70\uB4E0."
      playerAnswerText: "[\uD0D0\uC0AC\uC790] \uC678\uB86D\uC9C4 \uC54A\uC544?"
      speakerAvatar: {fileID: 0}
    - speakerName: 
      npcDialogue: "\uC678\uB85C\uC6C0 \uAC19\uC740 \uAC70 \uB290\uB084 \uD2C8\uC774
        \uC5C6\uC5C8\uC5B4. \u2026\uC9C0\uAE08\uC740 \uC870\uAE08 \uC788\uB098."
      playerAnswerText: "[\uD0D0\uC0AC\uC790] ..."
      speakerAvatar: {fileID: 0}
  - sequenceId: karina_t3
    priority: 3
    minAffinity: 6
    maxAffinity: 999
    requiredCompanionCharId: 
    requiredEventFlag: 
    forbiddenEventFlag: 
    setEventFlagOnComplete: 
    steps:
    - speakerName: 
      npcDialogue: "\uB108\uD55C\uD14C\uC120 \uC774\uC0C1\uD55C \uAC8C \uB290\uAEF4\uC838.
        \uC6B4\uBA85\uC758 \uC528\uC2E4 \uAC19\uC740 \uAC70."
      playerAnswerText: "[\uD0D0\uC0AC\uC790] \uADF8\uAC8C \uBB34\uC2A8 \uB73B\uC774\uC57C?"
      speakerAvatar: {fileID: 0}
    - speakerName: 
      npcDialogue: "\uC544\uC9C1 \uB2E4 \uC548 \uD540 \uC7AC\uB2A5. \uC606\uC5D0\uC11C
        \uBCF4\uBA74 \uC7AC\uBC0C\uC744 \uAC83 \uAC19\uC544."
      playerAnswerText: "[\uD0D0\uC0AC\uC790] ..."
      speakerAvatar: {fileID: 0}
  recruit: {fileID: 11400000, guid: a644725714c87d74cab7c15855ae4157, type: 2}
  recruitMinTier: 3
  recruitPrompt: "\u2026\uB530\uB77C\uAC00 \uC918\uB3C4 \uB3FC. \uB124 \uC7AC\uB2A5\uC774
    \uC5B4\uB514\uAE4C\uC9C0 \uD53C\uB294\uC9C0, \uC606\uC5D0\uC11C \uBCF4\uACE0
    \uC2F6\uC5B4\uC84C\uC73C\uB2C8\uAE4C."
