  entityId: karina
  displayName: "\uCE74\uB9AC\uB098 \uBE48\uD130\uBC1C\uD2B8"
  affiliation: "\uB3C5\uC77C\uACC4 \uC815\uCC29\uBBFC / \uBCF4\uAE09 \uCC3D\uACE0"
  themeColor: {r: 0.85, g: 0.72, b: 0.38, a: 1}
  portrait: {fileID: 21300000, guid: 46bce3b3dc51f194db064317890b43c7, type: 3}
  standing: {fileID: 21300000, guid: 89641e5a0b38c8048820064892bacadd, type: 3}
  defeatAffinityGain: 0.5
