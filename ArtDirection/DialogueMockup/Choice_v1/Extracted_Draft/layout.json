    "label_rect_right_formula": "w-216 with tag; w-130 without tag",
    "longer_than_22": "truncate at grapheme boundary to21 characters + ellipsis; full original retained in data",
    "still_overflow": "TMP Ellipsis single line; no auto font shrink",
    "optional_tag": "hide if empty; reclaim its width for label; retain final divider/arrow",
